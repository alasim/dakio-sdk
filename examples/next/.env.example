# Your store's key: Dakio → Settings → Developers.
# Test key (dk_pub_test_…) while building — works on localhost, makes test orders.
# Live key (dk_pub_live_…) to go live — list your domain under "Allowed websites".
NEXT_PUBLIC_DAKIO_KEY=dk_pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Your site's public address, for canonical links, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: another Dakio API (e.g. a local one).
# NEXT_PUBLIC_DAKIO_API_URL=http://localhost:5001/api/sdk/v1

# Optional: refresh pages the moment a product changes (instead of every minute).
# Dakio → Settings → Developers → Webhooks → Add: https://<your site>/api/dakio/revalidate,
# events product.updated, product.deleted, stock.changed, store.updated. Paste its signing secret here.
# DAKIO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
