# Your store's key: Dakio → Settings → Developers.
# Use a dk_pub_test_ key while building (works on localhost, makes test orders),
# and a dk_pub_live_ key with your website listed under "Allowed websites" to go live.
VITE_DAKIO_KEY=dk_pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: point at another Dakio API (e.g. a local one).
# VITE_DAKIO_API_URL=http://localhost:5001/api/sdk/v1
