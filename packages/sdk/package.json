{
  "name": "@dakio/sdk",
  "version": "0.1.0",
  "description": "Build any store on Dakio \u2014 catalog, sale prices, COD checkout with fake-order protection, couriers and Nova behind your own React or Next.js site.",
  "license": "MIT",
  "author": "Dakio <hello@dakio.io>",
  "homepage": "https://www.dakio.io/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alasim/dakio-sdk.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "dakio",
    "ecommerce",
    "headless",
    "bangladesh",
    "cod",
    "storefront",
    "react",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./bd": {
      "types": "./dist/bd/index.d.ts",
      "import": "./dist/bd/index.js",
      "require": "./dist/bd/index.cjs"
    },
    "./pixel": {
      "types": "./dist/pixel/index.d.ts",
      "import": "./dist/pixel/index.js",
      "require": "./dist/pixel/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/use-client.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
