{
  "name": "@dakio/sdk",
  "version": "0.2.0",
  "description": "Build any store on Dakio — catalog, sale prices, COD checkout with fake-order protection, couriers and Nova behind your own React or Next.js site.",
  "license": "MIT",
  "author": "Dakio <hello@dakio.io>",
  "homepage": "https://www.dakio.io/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alasim/dakio-sdk.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "dakio",
    "ecommerce",
    "headless",
    "bangladesh",
    "cod",
    "storefront",
    "react",
    "nextjs",
    "webhooks"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.cts"
      ],
      "next": [
        "./dist/next/index.d.cts"
      ],
      "bd": [
        "./dist/bd/index.d.cts"
      ],
      "pixel": [
        "./dist/pixel/index.d.cts"
      ],
      "webhooks": [
        "./dist/webhooks/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./bd": {
      "import": {
        "types": "./dist/bd/index.d.ts",
        "default": "./dist/bd/index.js"
      },
      "require": {
        "types": "./dist/bd/index.d.cts",
        "default": "./dist/bd/index.cjs"
      }
    },
    "./pixel": {
      "import": {
        "types": "./dist/pixel/index.d.ts",
        "default": "./dist/pixel/index.js"
      },
      "require": {
        "types": "./dist/pixel/index.d.cts",
        "default": "./dist/pixel/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks/index.d.ts",
        "default": "./dist/webhooks/index.js"
      },
      "require": {
        "types": "./dist/webhooks/index.d.cts",
        "default": "./dist/webhooks/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/use-client.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package",
    "release": "npm publish --access public",
    "check:package": "attw --pack ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
